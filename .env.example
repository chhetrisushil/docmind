# Copy to .env (git-ignored) and load it into your shell: set -a; . ./.env; set +a
# Hosts and credentials match docker-compose.yml.

# HTTP server
HOST=127.0.0.1
PORT=3000

# Postgres. The OWNER role runs migrations (pnpm --filter @docmind/server db:migrate); the server
# itself connects as docmind_app, which owns nothing and cannot bypass row-level security.
DOCMIND_MIGRATE_URL=postgres://docmind:docmind@127.0.0.1:5432/docmind
DOCMIND_APP_DB_PASSWORD=change-me-locally
# Lets Loom's Postgres stores log in as docmind_loom (owns only the loom schema).
DOCMIND_LOOM_DB_PASSWORD=change-me-too
DATABASE_URL=postgres://docmind_app:change-me-locally@127.0.0.1:5432/docmind
# Loom's event log and snapshots live in schema loom, owned by docmind_loom.
LOOM_DATABASE_URL=postgres://docmind_loom:change-me-too@127.0.0.1:5432/docmind

# Master key that wraps every user's data key. Generate: openssl rand -base64 32
# Losing it makes all encrypted data unreadable; leaking it exposes the wrapped data keys.
# (Or DOCMIND_KEK_FILE=<path to a file holding it>.)
DOCMIND_KEK=
DOCMIND_KEK_ID=kek-1
# Only while rotating the KEK (docs/operations/rotate-kek.md): the key being retired. Set BOTH;
# an ID without its key is ignored.
# DOCMIND_KEK_PREVIOUS=
# DOCMIND_KEK_PREVIOUS_ID=

# Set to true when the server is reached over HTTPS (marks the session cookie Secure).
# Behind a reverse proxy, forward Host unchanged (nginx: proxy_set_header Host $host), or set
# DOCMIND_PUBLIC_ORIGIN below; otherwise browser writes without Fetch Metadata are refused with 403.
DOCMIND_COOKIE_SECURE=false

# The browser-visible origin (scheme://host[:port], no path), for a proxy that rewrites Host. When set,
# the Origin check of writes without Fetch Metadata compares against it instead of the Host header.
# Write an IDN host as punycode, and omit the default port (:80 for http, :443 for https).
# DOCMIND_PUBLIC_ORIGIN=https://docmind.example.com

# Believe X-Forwarded-For for the client address (login/sign-up throttling). Set to true only when the
# server sits behind exactly one reverse proxy of yours; otherwise any client could fake its address.
DOCMIND_TRUST_PROXY=false

# Enables the Postgres integration tests (they skip when unset). The role must be able to
# CREATE DATABASE: each suite makes, and drops, a database of its own.
DOCMIND_TEST_PG_URL=postgres://docmind:docmind@127.0.0.1:5432/docmind

# Where encrypted document blobs are stored (a directory the server user owns; default ./data/blobs).
DOCMIND_BLOB_DIR=./data/blobs
# Upload quotas (defaults shown). The per-file limit is at most 268435456.
DOCMIND_MAX_UPLOAD_BYTES=52428800
DOCMIND_TENANT_MAX_BYTES=1073741824
DOCMIND_TENANT_MAX_DOCUMENTS=500
DOCMIND_MAX_CONCURRENT_UPLOADS=2
# Most simultaneous HTTP connections (default 2000, at most 65535).
# DOCMIND_MAX_CONNECTIONS=2000

# Document ingestion (defaults shown; each is validated at startup and an invalid one is named, never printed).
# Parser child process: wall clock per parse, its memory cap, the longest text it may return, and parses at once.
# DOCMIND_PARSE_TIMEOUT_MS=30000
# DOCMIND_PARSE_MEMORY_MB=512
# DOCMIND_PARSE_MAX_CHARS=20000000
# The most document text one summary reads (default 400000, at most 5000000); the reduce prompt grows with it.
# DOCMIND_SUMMARY_MAX_CHARS=400000
# DOCMIND_PARSE_CONCURRENCY=2
# Fair sharing of ingest work: steps running at once across all tenants (default 4, 1-64), and per
# tenant (default 2, 1-64, at most the first).
# DOCMIND_INGEST_CONCURRENCY=4
# DOCMIND_INGEST_TENANT_CONCURRENCY=2
# Embeddings through Ollama. DIMENSIONS must match the chunks.embedding column (vector(768), migration 0014);
# the server refuses to start on a mismatch. A different model size needs a new migration.
# DOCMIND_OLLAMA_URL=http://127.0.0.1:11434
# DOCMIND_EMBED_MODEL=nomic-embed-text
# DOCMIND_EMBED_DIMENSIONS=768
# DOCMIND_EMBED_TIMEOUT_MS=30000

# Claude (optional). Without a key, summaries are skipped and images fail as vision_unavailable.
ANTHROPIC_API_KEY=
# Only to route through a proxy or gateway (default: the Anthropic API).
# ANTHROPIC_BASE_URL=
# DOCMIND_SUMMARY_MODEL=claude-haiku-5-5
# DOCMIND_VISION_MODEL=claude-sonnet-5-5
# DOCMIND_LLM_TIMEOUT_MS=60000
# Vision requests (images, up to 4 scanned PDF pages each) get their own, longer timeout (max 600000).
# DOCMIND_VISION_TIMEOUT_MS=180000
