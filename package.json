{
  "name": "docmind",
  "version": "0.0.0",
  "private": true,
  "description": "DocMind: a multi-user, RAG-based document assistant built on Loom.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "tsx --env-file=.env apps/server/app/main.ts",
    "serve": "pnpm db:start && pnpm build && pnpm db:migrate && pnpm start",
    "db:start": "sh infra/local-db.sh start",
    "db:stop": "sh infra/local-db.sh stop",
    "db:status": "sh infra/local-db.sh status",
    "db:migrate": "tsx --env-file=.env apps/server/app/db/migrate.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "turbo run typecheck:tests",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsx": "4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
