    "@loomwork/blueprint-runtime": "^0.1.0",
    "@loomwork/core": "^0.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/ui-renderer-terminal": "^0.1.0",
    "@loomwork/projection-runtime": "^0.1.0",
    "@types/node": "^22.0.0",
    "vitest": "^2.1.8"
