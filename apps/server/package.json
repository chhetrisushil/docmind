{
  "name": "@docmind/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "tsx app/main.ts",
    "backfill:ingest": "node dist/scripts/backfill-ingest.js",
    "gen": "loom gen --dir app",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "db:migrate": "tsx app/db/migrate.ts",
    "keys:rotate": "tsx app/keys/rotateKek.ts"
  },
  "dependencies": {
    "@docmind/auth": "workspace:*",
    "@docmind/blob-store": "workspace:*",
    "@docmind/contracts": "workspace:*",
    "@docmind/embeddings": "workspace:*",
    "@docmind/keystore-pg": "workspace:*",
    "@docmind/llm-anthropic": "workspace:*",
    "@docmind/parsers": "workspace:*",
    "@docmind/vector-pg": "workspace:*",
    "@loom/agent": "*",
    "@loom/app": "*",
    "@loom/conversation": "*",
    "@loom/core": "*",
    "@loom/classify": "*",
    "@loom/effect-runtime": "*",
    "@loom/fair-scheduler": "*",
    "@loom/knowledge": "*",
    "@loom/llm": "*",
    "@loom/memory": "*",
    "@loom/plugin-conversation-sse": "*",
    "@loom/plugin-crypto": "*",
    "@loom/plugin-postgres": "*",
    "@loom/plugin-read-model": "*",
    "@loom/workflow-runtime": "*",
    "busboy": "^1.6.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loom/cli": "*",
    "@loom/conformance": "*",
    "@loom/event-runtime": "*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
