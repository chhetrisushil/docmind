{
  "name": "@docmind/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "tsx app/main.ts",
    "backfill:ingest": "node dist/scripts/backfill-ingest.js",
    "gen": "loom gen --dir app",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "db:migrate": "tsx app/db/migrate.ts",
    "keys:rotate": "tsx app/keys/rotateKek.ts"
  },
  "dependencies": {
    "@docmind/auth": "workspace:*",
    "@docmind/blob-store": "workspace:*",
    "@docmind/contracts": "workspace:*",
    "@docmind/embeddings": "workspace:*",
    "@docmind/experiences": "workspace:*",
    "@docmind/keystore-pg": "workspace:*",
    "@docmind/llm-anthropic": "workspace:*",
    "@docmind/parsers": "workspace:*",
    "@docmind/vector-pg": "workspace:*",
    "@loomwork/ui-core": "*",
    "@loomwork/ui-lineage": "*",
    "@loomwork/ui-planner": "*",
    "@loomwork/agent": "*",
    "@loomwork/app": "*",
    "@loomwork/conversation": "*",
    "@loomwork/core": "*",
    "@loomwork/classify": "*",
    "@loomwork/compliance": "*",
    "@loomwork/effect-runtime": "*",
    "@loomwork/fair-scheduler": "*",
    "@loomwork/knowledge": "*",
    "@loomwork/llm": "*",
    "@loomwork/memory": "*",
    "@loomwork/plugin-content": "*",
    "@loomwork/plugin-conversation-sse": "*",
    "@loomwork/plugin-crypto": "*",
    "@loomwork/plugin-postgres": "*",
    "@loomwork/plugin-read-model": "*",
    "@loomwork/workflow-runtime": "*",
    "busboy": "^1.6.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/cli": "*",
    "@loomwork/conformance": "*",
    "@loomwork/event-runtime": "*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
