{
  "name": "@docmind/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "tsx app/main.ts",
    "backfill:ingest": "node dist/scripts/backfill-ingest.js",
    "gen": "loom gen --dir app",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "db:migrate": "tsx app/db/migrate.ts",
    "keys:rotate": "tsx app/keys/rotateKek.ts"
  },
  "dependencies": {
    "@docmind/auth": "workspace:*",
    "@docmind/blob-store": "workspace:*",
    "@docmind/contracts": "workspace:*",
    "@docmind/embeddings": "workspace:*",
    "@docmind/experiences": "workspace:*",
    "@docmind/keystore-pg": "workspace:*",
    "@docmind/llm-anthropic": "workspace:*",
    "@docmind/parsers": "workspace:*",
    "@docmind/vector-pg": "workspace:*",
    "@loomwork/ui-core": "next",
    "@loomwork/ui-lineage": "next",
    "@loomwork/ui-planner": "next",
    "@loomwork/agent": "next",
    "@loomwork/app": "next",
    "@loomwork/conversation": "next",
    "@loomwork/core": "next",
    "@loomwork/classify": "next",
    "@loomwork/compliance": "next",
    "@loomwork/effect-runtime": "next",
    "@loomwork/fair-scheduler": "next",
    "@loomwork/knowledge": "next",
    "@loomwork/llm": "next",
    "@loomwork/memory": "next",
    "@loomwork/plugin-content": "next",
    "@loomwork/plugin-conversation-sse": "next",
    "@loomwork/plugin-crypto": "next",
    "@loomwork/plugin-postgres": "next",
    "@loomwork/plugin-read-model": "next",
    "@loomwork/workflow-runtime": "next",
    "busboy": "^1.6.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loomwork/cli": "next",
    "@loomwork/conformance": "next",
    "@loomwork/event-runtime": "next",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
